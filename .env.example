# Database Settings
DATABASE_URL=postgresql+asyncpg://savings_user:savings_dev_password@localhost:5433/savings_dev
DATABASE_SSL=False
# Optional: path to CA certificate file for SSL connections (e.g. Neon or other serverless Postgres providers)
# DATABASE_CA_FILE=/path/to/ca.pem

# Application Settings
ENVIRONMENT=development
JWT_SECRET=dev_secret_jwt_key_must_be_changed_in_production_32chars
RESET_PASSWORD_TOKEN_SECRET=dev_reset_password_secret_key_must_be_changed_32chars
VERIFICATION_TOKEN_SECRET=dev_verification_secret_key_must_be_changed_in_32chars

# Port binding (for running uvicorn directly outside of Docker Compose)
PORT=8000
