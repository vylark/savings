{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Pytest (Docker)",
      "type": "shell",
      "command": "docker-compose run --rm web pytest",
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "Pytest File (Docker)",
      "type": "shell",
      "command": "docker-compose run --rm web pytest ${relativeFile}",
      "group": "test",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "Ruff Check (Docker)",
      "type": "shell",
      "command": "docker-compose run --rm web ruff check",
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    }
  ]
}
